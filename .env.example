# ==============================================================================
# Exam Monitor — Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# NEVER commit secrets, service-role keys, or bot tokens to source control.
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Managed Database & Auth
# Obtain these from your Supabase Project Dashboard -> Settings -> API / Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Direct PostgreSQL Connection URL (used by Drizzle ORM and Supabase CLI for migrations)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Monitoring Worker Configuration
# Target endpoint to poll (must be an HTTPS URL on an allowed domain)
# Example official endpoint: https://exam-booking.sa.gov.ge/practical/dates?CategoryCode=4&CenterId=7&isFirstAttempt=0
EXAM_API_ENDPOINT=https://exam-booking.sa.gov.ge/practical/dates?CategoryCode=4&CenterId=7&isFirstAttempt=0
ALLOWED_EXAM_HOSTS=exam-booking.sa.gov.ge,localhost,127.0.0.1
POLL_INTERVAL_SECONDS=30
MIN_POLL_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_MS=35000
MAX_BACKOFF_SECONDS=45
WORKER_LEASE_DURATION_SECONDS=30

# Telegram Bot Integration
# Generated by @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=YourExamMonitorBot
# Mode: 'webhook' (recommended for production) or 'polling' (convenient for local dev)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-cryptographically-random-webhook-secret
TELEGRAM_LINKING_TOKEN_TTL_SECONDS=600

# Benchmark Configuration
BENCHMARK_MAX_DURATION_SECONDS=180
BENCHMARK_MAX_REQUESTS=30
